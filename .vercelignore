# Ignore raw & heavy parquet dataset files (450+ MB)
data/raw/
data/processed/*.parquet

# Ignore reports and figures
reports/
!reports/figures/

# Ignore test scripts and dev utilities
tests/
inspect_dataset*.py
analyze_columns.py
verify_container_runtime.py

# Ignore Docker & deployment docs
Dockerfile
docker-compose.yml
DEPLOYMENT*.md

# Ignore git
.git

# Ignore training/dev-only scripts (not needed by the live API)
ml/train.py
ml/evaluate.py
ml/data_loader.py

# Ignore unused candidate models (only final_model + preprocessing_pipeline needed at runtime)
models/candidate_*.joblib
